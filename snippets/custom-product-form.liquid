<custom-product-form class="custom-product-form" {{ block.shopify_attributes }}>
  {%- form 'product',
          product
  -%}
    <input type="hidden" name="id" value="{{ current_variant.id }}">

    {% if show_cusomer_form %}
      <h3>Customer information</h3>
      <div class="custom-product-customer-info">
        <div class="form-group">
          <input id="customer-info-first-name" type="text" name="properties[first_name]" placeholder=" " required />
          <label for="customer-info-first-name">First Name *</label>
        </div>
        <div class="form-group">
          <input id="customer-info-second-name" type="text" name="properties[last_name]" placeholder=" " required />
          <label for="customer-info-second-name">Second Name *</label>
        </div>
        <div class="form-group">
          <input id="customer-info-email" type="email" name="properties[email]" placeholder=" " required />
          <label for="customer-info-email">Email *</label>
        </div>
        <div class="form-group">
          <input id="customer-info-phone" type="text" name="properties[phone_number]" placeholder=" " required/>
          <label for="customer-info-phone">Phone Number *</label>
        </div>
        <div class="form-group">
          <input id="customer-info-post-code" type="text" name="properties[post_code]" placeholder=" " required />
          <label for="customer-info-post-code">Post Code *</label>
        </div>
        <div class="form-group">
          <input id="customer-info-birthdate" type="date" name="properties[date_of_birth]" required />
          <label for="customer-info-birthdate">Date of birth *</label>
        </div>
        <div class="form-group">
          <select id="customer-info-gender" name="properties[gender]">
            <option value="male">Male</option>
            <option value="female">Female</option>
          </select>
          <label for="customer-info-gender">Gender *</label>
        </div>
        <div class="form-group">
          <input id="customer-info-code" type="number" name="properties[customer_code]" placeholder=" ">
          <label for="customer-info-code">Customer code</label>
        </div>
      </div>
    {% endif %}

    <button type="submit" name="add">
      <span class="add-to-cart__title">
        Add to cart
      </span>
    </button>

    {{ form | payment_button }}
  {%- endform -%}
</custom-product-form>
